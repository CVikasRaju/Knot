# Environment configuration for Knot.
#
# Copy to `.env` and adjust. Every value here has a working default, so an
# empty .env is a valid local setup.

# ---- FalkorDB connection -------------------------------------------------
# 127.0.0.1 rather than "localhost": inside containers "localhost" often
# resolves to IPv6 ::1 while the published FalkorDB port is IPv4 only.
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=

# ---- Graph tenants -------------------------------------------------------
# FalkorDB isolates tenants by graph name. That is what makes the shadow-graph
# simulation cheap: a fork is just another graph in the same instance.
KNOT_PROD_GRAPH=prod_org_brain
KNOT_MEMORY_GRAPH=agent_memory
KNOT_SHADOW_PREFIX=shadow_sim_

# ---- Traversal bounds ----------------------------------------------------
# Multi-hop explosion is the main failure mode of graph agents, so every
# traversal is capped.
KNOT_MAX_HOPS=6
KNOT_TRAVERSAL_BUDGET=4000

# ---- Decision thresholds -------------------------------------------------
KNOT_CONFIDENCE_THRESHOLD=0.85
KNOT_CRITICALITY_THRESHOLD=0.30

# ---- Live topology change window (hours) ---------------------------------
KNOT_CHANGE_WINDOW_HOURS=2

# ---- Backends ------------------------------------------------------------
# Set to 1 to use the in-process backend instead of a real FalkorDB. Tests set
# this; production never does.
KNOT_MEMORY_BACKEND=0

# Knot runs on FalkorDB, so a missing engine is a hard failure by default.
# Set to 1 only for tests, to run against an in-process store with an empty
# graph instead of raising.
# KNOT_ALLOW_MEMORY_FALLBACK=0

# When 1 (the default) mutating actions are planned and reported but not
# executed. Set to 0 to let the executor actually open PRs / page people.
KNOT_ACTIONS_DRY_RUN=1

# ---- API -----------------------------------------------------------------
KNOT_API_HOST=0.0.0.0
KNOT_API_PORT=8000
KNOT_FRONTEND_ORIGIN=*
